{
  "name": "quiz-relay",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test -w e2e",
    "lint": "eslint . && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.28.1"
  }
}

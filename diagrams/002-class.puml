@startuml 002-class
title 002 匯入 Guided Notes — 類別圖（依 TECH_SPEC v1.6）
hide empty members

package "試算表快照" {
  class GridRange {
    +sheetId: number
    +startRowIndex: number
    +endRowIndex: number
    +startColumnIndex: number
    +endColumnIndex: number
  }
  class SheetData {
    +sheetId: number
    +title: string
    +values: string[][]
    +merges: GridRange[]
  }
  class SheetSnapshot {
    +spreadsheetId: string
    +sheets: SheetData[]
  }
  class CellWrite {
    +sheetTitle: string
    +a1: string
    +value: string
  }
}

package "解析結果" {
  enum ParseWarningCode {
    NON_CONSECUTIVE_NUMBERS
    SUBNO_MISMATCH
  }
  class ParseWarning {
    +code: ParseWarningCode
    +message: string
    +questionNumber?: number
  }
  class ParseResult {
    +sheetTitle: string
    +headerRow: number
    +numberCol: number
    +answerCol: number
    +questions: ParsedQuestion[]
    +warnings: ParseWarning[]
  }
  class ParsedQuestion {
    +number: number
    +isGroup: boolean
    +slots: ParsedSlot[]
  }
  class ParsedSlot {
    +subNo: number
    +sheetTitle: string
    +row: number
    +col: number
    +a1: string
    +prefix: string
    +originalValue: string
  }
  class ImportSummary {
    +questionCount: number
    +groupCount: number
    +singleCount: number
    +subQuestionCount: number
    +warnings: ParseWarning[]
  }
}

package "保存的實體" {
  class Session {
    +id: string
    +phase: Phase
    +spreadsheetId: string | null
    +sheetTitle: string | null
  }
  class Question {
    +id: string
    +sessionId: string
    +number: number
    +isGroup: boolean
    +subCount: number
    +state: QuestionState
    +windowEndsAt: number | null
  }
  class AnswerSlot {
    +id: string
    +questionId: string
    +subNo: number
    +sheetTitle: string
    +row: number
    +col: number
    +a1: string
    +prefix: string
    +originalValue: string
  }
  class QuestionInfo {
    +id: string
    +number: number
    +isGroup: boolean
    +subCount: number
    +subLabels: string[]
  }
}

package "函式模組" {
  class parser <<module>> {
    +parseGuidedNotes(snapshot: SheetSnapshot): ParseResult
    +summarize(result: ParseResult): ImportSummary
  }
  class a1 <<module>> {
    +colToLetters(col: number): string
    +toA1(row: number, col: number): string
    +quoteSheet(title: string): string
    +rangeA1(sheetTitle: string, a1: string): string
    +parseSpreadsheetInput(input: string): string
  }
  class projections <<module>> {
    +questionInfo(q: Question, slots: AnswerSlot[]): QuestionInfo
  }
}

interface SheetsGateway {
  +fetchSnapshot(spreadsheetId: string): Promise<SheetSnapshot>
  +writeCells(spreadsheetId: string, writes: CellWrite[]): Promise<void>
}
class GoogleSheetsGateway <<createGoogleGateway(client: sheets_v4.Sheets)>> {
  +fetchSnapshot(spreadsheetId: string): Promise<SheetSnapshot>
  +writeCells(spreadsheetId: string, writes: CellWrite[]): Promise<void>
}
note bottom of GoogleSheetsGateway
  錯誤對照：403 → SHEETS_PERMISSION_DENIED
  404 → SHEETS_NOT_FOUND；其他 → SHEETS_ERROR
  002：writeCells 丟出 SHEETS_ERROR（004 實作）
end note
class FakeSheetsGateway <<createFakeGateway(dir)>> {
  +fetchSnapshot(spreadsheetId: string): Promise<SheetSnapshot>
  +writeCells(spreadsheetId: string, writes: CellWrite[]): Promise<void>
  +getSnapshot(spreadsheetId: string): SheetSnapshot
  +reset(spreadsheetId: string): void
}
note bottom of FakeSheetsGateway
  id 必須為「fixture-{名稱}」，讀 {dir}/{名稱}.snapshot.json
  不符合或檔案不存在 → SHEETS_NOT_FOUND
  002：writeCells 丟出 SHEETS_ERROR（004 實作）
end note

class devRoutes <<module>> {
  +devRoutes(fake: FakeSheetsGateway): Router
  GET /api/dev/fake-sheets/:spreadsheetId
  POST /api/dev/fake-sheets/:spreadsheetId/reset
}

class SessionAggregate {
  +session: Session
  +questions: Question[]
  +slots: AnswerSlot[]
  +importSummary: ImportSummary | null
  ...（teams、members、drafts、submissions、onlineMemberIds）
}

class Repo {
  +getImportSummary(sessionId: string): ImportSummary | null
  +setImportSummary(sessionId: string, summary: ImportSummary): void
  +deleteQuestionsBySession(sessionId: string): void
  +insertQuestion(q: Question): void
  +insertSlot(s: AnswerSlot): void
  +listQuestions(sessionId: string): Question[]
  +listSlotsBySession(sessionId: string): AnswerSlot[]
}

class SessionService {
  +importSheet(sessionId: string, spreadsheetInput: string): Promise<{view: TeacherView, summary: ImportSummary}>
}

SheetSnapshot "1" *-- "1..*" SheetData
SheetData "1" *-- "0..*" GridRange
ParseResult "1" *-- "1..*" ParsedQuestion
ParseResult "1" *-- "0..*" ParseWarning
ParsedQuestion "1" *-- "1..*" ParsedSlot
ParseWarning --> ParseWarningCode
ImportSummary "1" *-- "0..*" ParseWarning

Session "1" o-- "0..*" Question
Question "1" *-- "1..*" AnswerSlot
ParsedQuestion ..> Question : 匯入時轉為
ParsedSlot ..> AnswerSlot : 匯入時轉為
projections ..> QuestionInfo : 產生
projections ..> SessionAggregate : 讀取（importSummary → TeacherView）
SessionAggregate o-- ImportSummary

SheetsGateway <|.. GoogleSheetsGateway
SheetsGateway <|.. FakeSheetsGateway
SheetsGateway ..> SheetSnapshot : 回傳
SheetsGateway ..> CellWrite : 寫回（004 使用）

parser ..> SheetSnapshot : 讀取
parser ..> ParseResult : 產生
parser ..> ImportSummary : 產生
parser ..> a1 : toA1

GoogleSheetsGateway ..> a1 : quoteSheet
devRoutes --> FakeSheetsGateway
SessionService --> Repo : 注入
SessionService --> SheetsGateway : 注入
SessionService ..> a1 : parseSpreadsheetInput
SessionService ..> parser
SessionService ..> Question : 建立／取代
SessionService ..> AnswerSlot : 建立／取代
SessionService ..> Session : phase=READY、spreadsheetId、sheetTitle
@enduml

@startuml 002-component
title 002 匯入 Guided Notes — 組件圖（依 TECH_SPEC v1.6）
skinparam componentStyle uml2
left to right direction

actor 老師 as T

package "瀏覽器（老師端）" {
  [管理頁\nTeacherDashboard\n(READY 題號清單，題組標示子題)] as TDash
  [匯入表單\nImportForm\n(import-input、import-submit；\n空白或 busy 時 disabled，忙碌時文字「匯入中…」)] as Form
  [匯入摘要\nImportSummary\n(import-summary：「偵測到 N 題，其中 M 題組（共 K 子題）、L 單題」；\nimport-question-count、import-group-count、import-warning-{i})] as Sum
  [錯誤橫幅\nErrorBanner（001）\n(ImportForm 引用；HEADER_NOT_FOUND 時\nImportForm 於下方附範本格式說明)] as Err
  [useTeacher.importSheet\n(busy 狀態)] as Hook
}

package "伺服器" {
  [啟動與設定\nindex.ts / config.ts\n(依 SHEETS_MODE 組裝 gateway)] as Boot
  [HTTP 路由\nPOST /api/teacher/sessions/:id/import] as Http
  [開發用路由 devRoutes\n(只在 SHEETS_MODE=fake 掛載)\nGET /api/dev/fake-sheets/:id\nPOST /api/dev/fake-sheets/:id/reset] as Dev
  [匯入服務\nSessionService.importSheet] as Svc
  [階段規則\ndomain/phase\n(import 僅允許 SETUP、READY)] as Phase
  [網址與位址\nsheets/a1\nparseSpreadsheetInput、toA1、quoteSheet] as A1
  [解析器\nsheets/parser\nparseGuidedNotes、summarize] as Parser
  [視圖投影\ndomain/projections\nquestionInfo（只含題號與子題標籤）] as Proj
  [即時推播\nBroadcaster] as BC
  [資料存取\nRepo\n(sessions、questions、answer_slots；\ndrafts 隨 questions 連帶刪除)] as Repo

  interface "SheetsGateway" as GW
  [Google 試算表閘道\ngoogleGateway\n(SHEETS_MODE=google；writeCells 待 004)] as GG
  [示範模式閘道\nfakeGateway\n(SHEETS_MODE=fake；writeCells 待 004)] as FG
}

cloud "Google Sheets" as GS
folder "fixtures/sheets\n(fixture-{名稱} → {名稱}.snapshot.json)" as FX
database "資料庫\n(sessions / questions / answer_slots / drafts)" as DB

T --> Form : 貼上網址或 ID，按「匯入」
TDash --> Form
TDash --> Sum
Form --> Err
Form --> Hook
Hook --> Http : { spreadsheet }

Boot --> GG : google 模式
Boot --> FG : fake 模式
Boot --> Dev : fake 模式才掛載

Http --> Svc : importSheet(sessionId, input)
Svc --> Phase : 檢查允許階段（讀取前、交易內各一次）
Svc --> A1 : 取出 spreadsheetId
Svc --> GW : fetchSnapshot(id)
GW <|.. GG
GW <|.. FG
GG --> GS : 讀取工作表、合併範圍、顯示值
GG --> A1 : quoteSheet(title)
FG --> FX : 讀取範例快照
Dev --> FG : getSnapshot(id)／reset(id)
Svc --> Parser : parseGuidedNotes(snapshot)
Parser --> A1 : toA1(row, col)
Svc --> Repo : 交易內刪除舊題目（連帶作答格、草稿）\n寫入新題目、作答格、摘要
Repo --> DB
Svc --> BC : publish(sessionId)
BC --> Proj : TeacherView／TeamView
BC ..> TDash : teacher:state（題號清單、importSummary）
Http ..> Hook : 200 { view, summary }
Http ..> Hook : 4xx/5xx 錯誤碼 → ImportForm 顯示 ErrorBanner
@enduml
